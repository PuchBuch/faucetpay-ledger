# Copy to .env in the folder you run `fpl` from, or to ~/.faucetpay-ledger/.env
# (Windows: C:\Users\you\.faucetpay-ledger\.env). Never commit it.

# Faucet Owner Dashboard -> your faucet -> Manage -> API & Webhooks
FAUCETPAY_API_KEY=

# Optional: Telegram alerts for `fpl watch` (set both or none)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: SQLite file
# FPL_DB=C:/Users/you/.faucetpay-ledger/ledger.db
